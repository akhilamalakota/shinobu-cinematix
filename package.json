{
  "name": "shinobu-cinematix",
  "version": "1.0.0",
  "description": "A cinematic, terminal-native torrent discovery and downloader experience.",
  "type": "module",
  "bin": {
    "shinobu-cinematix": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "preview",
    "scripts/ensure-webrtc.cjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup",
    "postbuild": "node scripts/postbuild.cjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:seeding": "tsx scripts/verify-seeding.ts",
    "previews": "tsx scripts/render-previews.tsx",
    "postinstall": "node scripts/ensure-webrtc.cjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "shinobu",
    "shinobu-cinematix",
    "torrent",
    "torrent-client",
    "torrent-search",
    "downloader",
    "magnet",
    "magnet-links",
    "p2p",
    "webtorrent",
    "seeding",
    "tui",
    "terminal",
    "cli",
    "ink"
  ],
  "author": "Akhil Amalakota",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akhilamalakota/shinobu-cinematix.git"
  },
  "homepage": "https://shinobu.in",
  "bugs": {
    "url": "https://github.com/akhilamalakota/shinobu-cinematix/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "create-torrent": "^6.1.2",
    "env-paths": "^4.0.0",
    "fs-chunk-store": "^5.0.1",
    "ink": "^7.0.5",
    "parse-torrent": "^11.0.21",
    "react": "^19.2.7",
    "webtorrent": "^3.0.21"
  },
  "overrides": {
    "@node-datachannel/android-arm64": "0.33.0",
    "node-datachannel": "^0.33.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
